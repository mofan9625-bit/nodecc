---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import ToolsSection from '../../components/ToolsSection.astro';
---

<Layout
  title="科学上网工具集 · Clash / Sing-box / 客户端下载与 IP 检测 - 节点实验室"
  description="NodeLab 节点实验室汇聚科学上网必备工具：Clash Verge Rev、Sing-box 等主流代理客户端下载，IP 属地检测、DNS 泄漏测试、节点延迟测速等实用网络工具一站聚合。"
  type="website"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8 xl:gap-12">
      <main>
        <header class="mb-8">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-2">
            科学上网工具集合
          </h1>
          <p class="text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
            汇聚日常科学上网所需的全套工具，包含各平台最新代理客户端下载、IP 纯净度检测、DNS 泄漏排查和节点延迟测速工具。
          </p>
        </header>
        <ToolsSection />
      </main>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Sidebar />
        </div>
      </aside>
    </div>
  </div>
</Layout>
