---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../data/categories';
import { Sparkles, ChevronRight, ArrowRight, ShieldCheck, Zap, Layers, ArrowLeft } from 'lucide-astro';

const categoriesList = Object.values(CATEGORIES);
---

<Layout
  title="按需快速导航 · 6 大核心场景机场梯子专属选型指南 - 节点实验室"
  description="NodeLab 节点实验室根据您的核心使用场景（纯 IPLC 专线、4K/8K 流媒体全解锁、ChatGPT/Claude AI 专线、低延迟游戏电竞、高性价比平价、企业跨境出海等）提供精准机场选型与评测榜单。"
  type="website"
>
  <section class="relative py-10 md:py-14 lg:py-16">
    <div aria-hidden="true" class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-sky-500/10 dark:bg-sky-500/8 rounded-full blur-3xl"></div>
      <div class="absolute top-1/4 right-0 w-80 h-80 bg-indigo-500/8 dark:bg-indigo-600/10 rounded-full blur-3xl"></div>
    </div>

    <!-- 单栏宽版容器 -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 flex items-center gap-1">
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>首页</span>
        </a>
        <ChevronRight class="w-3 h-3 text-slate-400" />
        <span class="text-slate-900 dark:text-white font-medium">按需分类导航</span>
      </nav>

      <div class="space-y-4 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
          <Zap class="w-3.5 h-3.5" />
          <span>按需精准定位 · 拒绝选择困难</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          新手必读 · 6 大场景按需快速导航
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          不同的使用需求对机场节点的网络架构、出口 IP 纯净度以及丢包率有着截然不同的指标要求。本站针对不同使用场景独立实测，精选 3~4 款核心机皇，拒绝千篇一律的机械化堆砌。
        </p>
      </div>

      <!-- 6 大专属分类卡片网格 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {categoriesList.map((cat) => (
          <a
            href={`/category/${cat.id}/`}
            class="glass-card rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-lg hover:border-sky-400 dark:hover:border-sky-600 transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-4xl group-hover:scale-110 transition-transform">{cat.emoji}</span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
                  {cat.badge}
                </span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-2">
                {cat.name}
              </h2>

              <p class="text-xs text-sky-600 dark:text-sky-400 font-medium mb-2.5">
                {cat.tagline}
              </p>

              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed mb-4">
                {cat.seoGuide}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-sky-600 dark:text-sky-400">
              <span>查看该分类专属榜单</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>
