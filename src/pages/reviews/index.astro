---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { CalendarDays, Clock, ChevronRight, Star, Zap, Filter } from 'lucide-astro';

const allReviews = await getCollection('reviews');
const sortedReviews = allReviews.sort((a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99));
---

<Layout
  title="全部机场梯子评测列表 · 2026 最新排行榜 - 节点实验室"
  description="NodeLab 节点实验室汇聚 2026 年最全面的机场梯子代理评测排行榜，包含 IPLC 专线、BGP 节点、流媒体解锁、ChatGPT 连通性及真实晚高峰速度数据，每日持续更新。"
  type="website"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

    <!-- 页面标题 -->
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-2">
        机场梯子综合评测排行榜
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
        共收录 {sortedReviews.length} 篇深度评测，基于真实晚高峰（20:30-22:30）网络环境自动化实测数据，每日更新。点击评测卡片查看完整多维度评分与使用指南。
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8 xl:gap-12">
      
      <!-- 评测列表主区域 -->
      <main>
        {sortedReviews.length === 0 ? (
          <div class="text-center py-16 text-slate-400">
            <p class="text-lg">评测文章加载中，敬请期待...</p>
          </div>
        ) : (
          <div class="space-y-5">
            {sortedReviews.map((review, idx) => (
              <article class="glass-card rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 hover:border-sky-300 dark:hover:border-sky-700 hover:shadow-md transition-all duration-200 group">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  
                  <!-- 排名徽章 -->
                  <div class="flex-shrink-0">
                    <span class={`w-10 h-10 rounded-xl flex items-center justify-center text-base font-black ${
                      idx === 0 ? 'bg-amber-500 text-white shadow-lg shadow-amber-500/30' :
                      idx === 1 ? 'bg-slate-400 text-white shadow-md' :
                      idx === 2 ? 'bg-amber-700/80 text-white' :
                      'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
                    }`}>
                      #{review.data.rank ?? idx + 1}
                    </span>
                  </div>

                  <!-- 主要内容 -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <div>
                        {review.data.badge && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mr-2">
                            <Star class="w-2.5 h-2.5 fill-current" />
                            {review.data.badge}
                          </span>
                        )}
                        <h2 class="inline text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                          <a href={`/reviews/${review.id}/`}>{review.data.title}</a>
                        </h2>
                      </div>
                      <span class="flex-shrink-0 text-2xl font-black text-emerald-500">
                        {review.data.rating.overall}
                        <span class="text-xs text-slate-400 font-normal">/10</span>
                      </span>
                    </div>

                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-3 line-clamp-2 leading-relaxed">
                      {review.data.description}
                    </p>

                    <!-- 关键指标行 -->
                    <div class="flex flex-wrap items-center gap-2 text-xs mb-4">
                      <span class="flex items-center gap-1 px-2 py-1 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 font-medium">
                        <Zap class="w-3 h-3" />
                        {review.data.lineType}
                      </span>
                      <span class="px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono font-semibold">
                        {review.data.pricing.currency}{review.data.pricing.minMonthly}{review.data.pricing.period}
                      </span>
                      {review.data.streamingUnlock.slice(0, 3).map(s => (
                        <span class="px-2 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 font-medium">
                          {s}
                        </span>
                      ))}
                    </div>

                    <!-- 底部操作行 -->
                    <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800">
                      <time datetime={new Date(review.data.pubDate).toISOString()} class="flex items-center gap-1 text-[11px] text-slate-400">
                        <CalendarDays class="w-3.5 h-3.5" />
                        {new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(review.data.pubDate))} 实测
                      </time>
                      <div class="flex items-center gap-2">
                        <a
                          href={review.data.affiliateUrl}
                          target="_blank"
                          rel="nofollow sponsored noopener noreferrer"
                          class="px-3 py-1.5 text-xs font-bold text-white rounded-lg bg-sky-500 hover:bg-sky-600 transition-colors"
                        >
                          直达官网
                        </a>
                        <a
                          href={`/reviews/${review.id}/`}
                          class="px-3 py-1.5 text-xs font-semibold text-sky-600 dark:text-sky-400 rounded-lg border border-sky-200 dark:border-sky-800/60 hover:bg-sky-50 dark:hover:bg-sky-950/30 transition-colors flex items-center gap-1"
                        >
                          深度评测 <ChevronRight class="w-3.5 h-3.5" />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </main>

      <!-- 右侧侧边栏 -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Sidebar />
        </div>
      </aside>

    </div>
  </div>
</Layout>
