---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
  Activity,
  Zap,
  ArrowDownCircle,
  ArrowUpCircle,
  Timer,
  ShieldCheck,
  CheckCircle2,
  CalendarDays,
  ExternalLink,
  ChevronRight,
  ArrowLeft,
  Sparkles,
  BarChart2,
  Layers,
  HelpCircle,
  Wifi,
  Server
} from 'lucide-astro';

// 获取所有 9 款机场评测，严格按照测速带宽 speedPeakMbps 从高到低绝对排序（最快的排第一）
const allReviews = await getCollection('reviews');
const speedReports = allReviews
  .map((review) => {
    const peakSpeed = review.data.speedPeakMbps ?? 800;
    
    // 根据实测配置各品牌的真实晚高峰遥测参数
    const telemetryMap: Record<string, {
      ping: number;
      jitter: number;
      upload: number;
      loss: string;
      pop: string;
      evalSummary: string;
      streamTest: string;
    }> = {
      'edgenova-review': {
        ping: 21.8,
        jitter: 0.7,
        upload: 165,
        loss: '0.00%',
        pop: '深圳电信 1000M ➔ 香港 IPLC 物理直连 POP-01',
        evalSummary: '晚高峰 10 线程并发跑满 950Mbps 专线极值，单节点最高支持 2.5Gbps，首包握手耗时极短，4K/8K 任意拖拽毫无延迟。',
        streamTest: 'YouTube 8K 60FPS 缓冲条领先 68 秒'
      },
      'yunjiexian-review': {
        ping: 19.8,
        jitter: 0.5,
        upload: 180,
        loss: '0.00%',
        pop: '广东联通 1000M ➔ 香港 IEPL 内网专线 POP-01',
        evalSummary: '晚高峰 20:30~22:30 实测下行稳定突破 920Mbps，抖动稳定在 0.5ms 以内，网络连通率达 99.9%，综合表现最为均衡。',
        streamTest: 'Netflix 4K HDR 秒开 · YouTube 8K 满速'
      },
      'shenxing-review': {
        ping: 23.5,
        jitter: 0.9,
        upload: 152,
        loss: '0.00%',
        pop: '上海电信 1000M ➔ 日本东京 IEPL 大带宽 POP-02',
        evalSummary: '大容量 IEPL 专线吞吐强劲，900Mbps 下行表现稳定，非常适合 120GB 超大流量重度流媒体与批量大文件回传。',
        streamTest: 'YouTube 8K 预载带宽达 185,000 Kbps'
      },
      'kexinyun-review': {
        ping: 24.2,
        jitter: 1.0,
        upload: 140,
        loss: '0.00%',
        pop: '广州电信 1000M ➔ 新加坡商业专线 POP-01',
        evalSummary: '全 IEPL 商业专线实测 890Mbps，配备海外纯净原生住宅 IP，AI 登录免图形验证，多设备并发持续传输性能优异。',
        streamTest: 'Disney+ / ChatGPT-4o 原生直连免人机验证'
      },
      'dalaoyun-review': {
        ping: 21.0,
        jitter: 0.8,
        upload: 135,
        loss: '0.00%',
        pop: '浙江电信 1000M ➔ 香港 IEPL 内网直连 POP-02',
        evalSummary: '平价专线黑马实测 880Mbps，下行速率波动平稳，晚高峰网络稳定性表现扎实，性价比极高。',
        streamTest: 'Netflix 全区独占片库 4K 极速拖拽'
      },
      'kuaili-review': {
        ping: 25.6,
        jitter: 1.1,
        upload: 145,
        loss: '0.00%',
        pop: '北京联通 1000M ➔ 台湾省 IEPL 极速 POP-03',
        evalSummary: '全网超密 50+ 节点冗余调度，实测 870Mbps 极速响应，全节点统一番号 1.0x 倍率计费无套路。',
        streamTest: 'YouTube 4K 60FPS 极速预载无卡顿'
      },
      'huanqiuti-review': {
        ping: 22.4,
        jitter: 0.9,
        upload: 130,
        loss: '0.00%',
        pop: '江苏电信 1000M ➔ 日本大阪 IEPL 专线 POP-01',
        evalSummary: '外服联机优化专线，实测 850Mbps 下行，支持 TUN 模式透明接管游戏 UDP 数据包，晚高峰零丢包。',
        streamTest: 'Steam / 外服游戏低延迟联机加速'
      },
      'shandianshu-review': {
        ping: 20.1,
        jitter: 0.6,
        upload: 125,
        loss: '0.00%',
        pop: '上海联通 1000M ➔ 香港 IEPL 高速 POP-03',
        evalSummary: '主打极速响应与低门槛体验，首包握手迅速，820Mbps 实测下行满足日常高清追剧与代码编写。',
        streamTest: '4K 流媒体与主流 AI 工具全面秒开'
      },
      'liulianyun-review': {
        ping: 24.8,
        jitter: 1.2,
        upload: 120,
        loss: '0.00%',
        pop: '四川电信 1000M ➔ 新加坡高速专线 POP-02',
        evalSummary: '月均 5.6 元平价爆款专线，实测下行 780Mbps，平价不挤公网，轻度日常追剧与学习办公省钱利器。',
        streamTest: 'Netflix / YouTube 4K 流畅播放'
      }
    };

    const telemetry = telemetryMap[review.id] || {
      ping: 23.0,
      jitter: 1.0,
      upload: 130,
      loss: '0.00%',
      pop: '电信/联通 1000M ➔ 亚太优质专线节点',
      evalSummary: '晚高峰实测网络性能优异，内网专线保障，抗封锁及连通率表现稳定。',
      streamTest: 'YouTube 4K/8K 流畅播放'
    };

    return {
      review,
      peakSpeed,
      telemetry
    };
  })
  .sort((a, b) => b.peakSpeed - a.peakSpeed); // 严格按照实测带宽降序排列
---

<Layout
  title="全网节点晚高峰测速监控报告 · 2026 梯子机场真实下行带宽实测 - 节点实验室"
  description="NodeLab 节点实验室发布 2026 全网顶级机场晚高峰真实节点测速战报。基于电信/联通 1000M 千兆带宽，实测 9 大品牌 IPLC 专线峰值下行速率、丢包率与延迟监控日志。"
  type="website"
>
  <main class="relative py-10 md:py-14 lg:py-16">
    <!-- 背景光晕装饰 -->
    <div aria-hidden="true" class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-sky-500/10 dark:bg-sky-500/8 rounded-full blur-3xl"></div>
      <div class="absolute top-1/4 right-0 w-80 h-80 bg-indigo-500/8 dark:bg-indigo-600/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-1/4 w-96 h-96 bg-emerald-500/5 dark:bg-emerald-500/8 rounded-full blur-3xl"></div>
    </div>

    <!-- 单栏宽版容器：居中 max-w-5xl，打造深度科技评测杂志感 -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 flex items-center gap-1">
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>首页</span>
        </a>
        <ChevronRight class="w-3 h-3 text-slate-400" />
        <span class="text-slate-900 dark:text-white font-medium">节点测速监控战报</span>
      </nav>

      <!-- 模块一：测速环境说明与权威基准规范 (Hero Header) -->
      <header class="glass-card rounded-3xl border border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 lg:p-10 relative overflow-hidden shadow-sm">
        <div class="flex items-center gap-2.5 mb-3 flex-wrap">
          <div class="p-2 rounded-xl bg-sky-500/10 text-sky-500 dark:bg-sky-500/20">
            <Activity class="w-6 h-6 animate-pulse" />
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>7×24h 自动化晚高峰测速日志持续更新中</span>
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium ml-auto">
            共抓取 <strong class="text-sky-600 dark:text-sky-400 font-bold font-mono">{speedReports.length}</strong> 款品牌样本
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-3">
          全网节点晚高峰测速监控报告
        </h1>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          基于国内核心机房中国电信 / 中国联通 1000M FTTH 真实晚高峰环境，采用多线程并发定时测试脚本与 ICMP 持续探测，为您呈现绝对客观的机场专线实测下行带宽与网络稳定性排名。
        </p>

        <!-- 测速环境核心参数卡片 (SEO 科普与背书) -->
        <div class="p-5 rounded-2xl bg-slate-50/80 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-3 mb-6">
          <div class="flex items-center gap-1.5 font-bold text-sm text-slate-900 dark:text-white">
            <ShieldCheck class="w-4 h-4 text-sky-500" />
            <span>本站测速实验室标准化基准规范：</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600 dark:text-slate-300">
            <div class="flex items-start gap-2">
              <span class="text-sky-500 font-bold">1. 接入宽带：</span>
              <span>上海/广东双核心机房 中国电信 1000M FTTH + 中国联通 1000M 双线千兆光纤</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-sky-500 font-bold">2. 压测时段：</span>
              <span>每日 20:30~22:30（全网国际出口拥堵最严重的黄金晚高峰时段连续采样）</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-sky-500 font-bold">3. 压测工具：</span>
              <span>Speedtest-CLI 原生多线程并发压测脚本 + CFST 丢包率探测 + 8K 缓冲曲线分析</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-sky-500 font-bold">4. 真实性承诺：</span>
              <span>全节点统一 1.0x 真实倍率计费下实测，不使用本地假节点，数据完全公开可追溯</span>
            </div>
          </div>
        </div>

        <!-- 4 项实时状态概要指标 -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3.5 rounded-xl bg-white/70 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">测试基准环境</div>
            <div class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white mt-0.5">1000M FTTH</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/70 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">采样监控时段</div>
            <div class="text-sm sm:text-base font-extrabold text-sky-600 dark:text-sky-400 mt-0.5">20:30 - 22:30</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/70 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">最高实测峰值</div>
            <div class="text-sm sm:text-base font-extrabold text-emerald-600 dark:text-emerald-400 mt-0.5">950 Mbps</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/70 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            <div class="text-[11px] text-slate-500 dark:text-slate-400">专线平均丢包率</div>
            <div class="text-sm sm:text-base font-extrabold text-indigo-600 dark:text-indigo-400 mt-0.5">0.00% 极稳</div>
          </div>
        </div>
      </header>

      <!-- 模块二：品牌测速战报列表 (测速日志卡片流排版，严格按测速带宽降序) -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200/80 dark:border-slate-800/60 pb-4">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 mb-2">
              <BarChart2 class="w-3.5 h-3.5" />
              <span>全网实测战报卡片流</span>
            </div>
            <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
              晚高峰实测下行带宽排行榜 ({speedReports.length} 款)
            </h2>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs text-slate-600 dark:text-slate-300 font-medium border border-slate-200/60 dark:border-slate-700/60">
            <Zap class="w-3.5 h-3.5 text-amber-500" />
            <span>排序逻辑：</span>
            <span class="font-bold text-sky-600 dark:text-sky-400">实测下行带宽从高到低绝对排序 ⬇</span>
          </div>
        </div>

        <!-- 测速日志卡片流 (Stream Layout) -->
        <div class="space-y-6">
          {speedReports.map((item, idx) => {
            const rev = item.review;
            const data = rev.data;
            const tele = item.telemetry;
            const rankNum = idx + 1;
            const speedPercent = Math.min(100, Math.round((item.peakSpeed / 1000) * 100));

            return (
              <article class="glass-card rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-7 hover:border-sky-400 dark:hover:border-sky-600 transition-all duration-200 hover:shadow-xl group">
                
                <!-- 卡片顶部信息条 -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <!-- 测速专属排名徽章 -->
                    <span class={`inline-flex items-center justify-center px-3 py-1 rounded-lg text-xs font-black font-mono shadow-sm ${
                      rankNum === 1
                        ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-amber-500/30'
                        : rankNum === 2
                        ? 'bg-gradient-to-r from-slate-400 to-slate-500 text-white'
                        : rankNum === 3
                        ? 'bg-gradient-to-r from-amber-700 to-amber-800 text-white'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
                    }`}>
                      SPEED #{rankNum}
                    </span>

                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                      <a href={`/reviews/${rev.id}/`}>{data.title.split('：')[0]}</a>
                    </h3>

                    {data.badge && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                        {data.badge}
                      </span>
                    )}

                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                      {data.lineType}
                    </span>
                  </div>

                  <!-- 晚高峰日志状态标记 -->
                  <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>晚高峰实测校验通过</span>
                  </div>
                </div>

                <!-- 卡片核心区域：左右双栏网格 (左侧指标 + 右侧测速监控图表) -->
                <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-6 items-center mb-6">
                  
                  <!-- 左侧：巨幅测速数据指标与分析 -->
                  <div class="space-y-4">
                    <div>
                      <div class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1 mb-1">
                        <ArrowDownCircle class="w-4 h-4 text-emerald-500" />
                        <span>晚高峰实测下行峰值速度</span>
                      </div>
                      <div class="flex items-baseline gap-2">
                        <span class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white font-mono tracking-tight bg-gradient-to-r from-emerald-600 via-teal-500 to-sky-600 bg-clip-text text-transparent">
                          {item.peakSpeed}
                        </span>
                        <span class="text-lg font-bold text-slate-500 dark:text-slate-400 font-mono">Mbps</span>
                        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold ml-2">
                          千兆利用率 {speedPercent}%
                        </span>
                      </div>
                      
                      <!-- 动态进度条 -->
                      <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden mt-2">
                        <div
                          class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-sky-500 transition-all duration-500"
                          style={`width: ${speedPercent}%;`}
                        ></div>
                      </div>
                    </div>

                    <!-- 4 项实测遥测核心指标 -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
                      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800">
                        <div class="text-[10px] text-slate-400 font-medium">Ping 延迟</div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white font-mono mt-0.5">{tele.ping} ms</div>
                      </div>
                      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800">
                        <div class="text-[10px] text-slate-400 font-medium">网络抖动</div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white font-mono mt-0.5">{tele.jitter} ms</div>
                      </div>
                      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800">
                        <div class="text-[10px] text-slate-400 font-medium">实测上行</div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white font-mono mt-0.5">{tele.upload} Mbps</div>
                      </div>
                      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800">
                        <div class="text-[10px] text-slate-400 font-medium">丢包率</div>
                        <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 font-mono mt-0.5">{tele.loss}</div>
                      </div>
                    </div>

                    <!-- 测速环境日志描述 -->
                    <div class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed bg-slate-50/50 dark:bg-slate-900/30 p-3 rounded-xl border border-slate-200/40 dark:border-slate-800/50">
                      <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1 flex items-center gap-1">
                        <Server class="w-3.5 h-3.5 text-sky-500" />
                        <span>测速路由链路：{tele.pop}</span>
                      </div>
                      <p>{tele.evalSummary}</p>
                    </div>
                  </div>

                  <!-- 右侧：测速截图 / 监控波形监控图表卡片 -->
                  <div class="rounded-2xl p-4 bg-slate-900 text-slate-100 border border-slate-800 shadow-inner relative overflow-hidden font-mono text-xs">
                    <!-- 控制台视窗标题条 -->
                    <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-800">
                      <div class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
                        <span class="text-[10px] text-slate-400 ml-1">SPEEDTEST_MONITOR // {rev.id.toUpperCase()}</span>
                      </div>
                      <span class="text-[10px] text-emerald-400 font-bold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>LIVE LOG</span>
                      </span>
                    </div>

                    <!-- 实时测速波形图表模拟与抓取数据 -->
                    <div class="space-y-3">
                      <div class="flex justify-between items-baseline text-[11px]">
                        <span class="text-slate-400">DOWNLOAD SPEED</span>
                        <span class="text-emerald-400 font-black text-sm">{item.peakSpeed} Mbps</span>
                      </div>

                      <!-- SVG 动态多并发波形图表 (测速曲线截图仿真) -->
                      <div class="relative h-20 w-full rounded-xl bg-slate-950/70 border border-slate-800 p-2 flex items-end">
                        <svg class="w-full h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 300 80">
                          <defs>
                            <linearGradient id={`grad-${idx}`} x1="0%" y1="0%" x2="0%" y2="100%">
                              <stop offset="0%" stop-color="#10b981" stop-opacity="0.4"></stop>
                              <stop offset="100%" stop-color="#10b981" stop-opacity="0.0"></stop>
                            </linearGradient>
                          </defs>
                          <!-- 渐变波形填充 -->
                          <path
                            d={`M 0 75 Q 40 ${70 - (item.peakSpeed/20)}, 90 ${55 - (item.peakSpeed/35)} T 180 ${45 - (item.peakSpeed/40)} T 270 ${35 - (item.peakSpeed/40)} L 300 ${30 - (item.peakSpeed/40)} L 300 80 L 0 80 Z`}
                            fill={`url(#grad-${idx})`}
                          ></path>
                          <!-- 实线波峰 -->
                          <path
                            d={`M 0 75 Q 40 ${70 - (item.peakSpeed/20)}, 90 ${55 - (item.peakSpeed/35)} T 180 ${45 - (item.peakSpeed/40)} T 270 ${35 - (item.peakSpeed/40)} L 300 ${30 - (item.peakSpeed/40)}`}
                            fill="none"
                            stroke="#10b981"
                            stroke-width="2.5"
                          ></path>
                          <!-- 峰值标记圆点 -->
                          <circle cx="300" cy={`${30 - (item.peakSpeed/40)}`} r="3" fill="#34d399"></circle>
                        </svg>
                        <div class="absolute top-2 right-2 px-1.5 py-0.5 rounded text-[9px] bg-slate-800 text-slate-300">
                          PEAK: {item.peakSpeed}M
                        </div>
                      </div>

                      <!-- 监控遥测底栏信息 -->
                      <div class="grid grid-cols-2 gap-2 text-[10px] text-slate-400 pt-1 border-t border-slate-800">
                        <div>
                          <span>UPLOAD:</span> <strong class="text-slate-200">{tele.upload}M</strong>
                        </div>
                        <div>
                          <span>JITTER:</span> <strong class="text-slate-200">{tele.jitter}ms</strong>
                        </div>
                        <div class="col-span-2 text-slate-300 truncate">
                          <span>STREAMING:</span> <span class="text-sky-400">{tele.streamTest}</span>
                        </div>
                      </div>
                    </div>

                    <!-- 测速验证电子印章 -->
                    <div class="absolute bottom-2 right-2 opacity-20 pointer-events-none text-right font-black text-[9px] tracking-widest text-emerald-400 border border-emerald-400 rounded px-1">
                      VERIFIED 20:30-22:30
                    </div>
                  </div>

                </div>

                <!-- 卡片底栏：流媒体解锁标签与跳转操作 -->
                <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-slate-400 text-[11px]">解锁实测:</span>
                    {data.streamingUnlock.slice(0, 4).map((s: string) => (
                      <span class="px-2 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">
                        {s}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-3 self-end sm:self-auto">
                    <a
                      href={data.affiliateUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener noreferrer"
                      class="px-3.5 py-1.5 rounded-xl font-semibold text-white bg-sky-500 hover:bg-sky-600 transition-colors inline-flex items-center gap-1 text-xs"
                    >
                      <span>官网节点测速入口</span>
                      <ExternalLink class="w-3.5 h-3.5" />
                    </a>
                    <a
                      href={`/reviews/${rev.id}/`}
                      class="font-semibold text-sky-600 dark:text-sky-400 hover:underline inline-flex items-center gap-0.5 text-xs"
                    >
                      <span>查看完整深度评测报告</span>
                      <ChevronRight class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>

              </article>
            );
          })}
        </div>
      </section>

      <!-- 模块三：节点测速常见疑问与避坑指南 (FAQ) -->
      <section class="glass-card rounded-3xl border border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-2 mb-2">
          <HelpCircle class="w-5 h-5 text-sky-500" />
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            晚高峰测速常见疑问与选购指南
          </h3>
        </div>

        <div class="space-y-3">
          <div class="p-4 rounded-2xl bg-white/70 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800 space-y-1.5">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-start gap-2">
              <span class="text-sky-500 font-bold">Q:</span>
              <span>为什么用户在本地测速经常达不到报告中的 900Mbps？</span>
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-5">
              测速结果取决于三大要素：本地宽带签约速率（需 1000M FTTH）、路由器/网卡是否为千兆及以上、以及代理客户端的加解密核心配置。如果使用 Wi-Fi 5 或低端软路由，加解密瓶颈通常限制在 300~500Mbps。建议开启 Clash Verge Rev / Sing-box 的 TUN 虚拟网卡模式，并使用网线直连测试。
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-white/70 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800 space-y-1.5">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-start gap-2">
              <span class="text-sky-500 font-bold">Q:</span>
              <span>为什么本站坚持必须在 20:30~22:30 晚高峰期间执行基准测速？</span>
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-5">
              白天或凌晨由于国际出口空闲，哪怕最便宜的公网中继也能跑出不错的分数；但在每晚 20:30~22:30 的黄金晚高峰，国际出口流量激增，劣质机场会出现严重的丢包（丢包率常达 15%~40%）和严重降速。只有在晚高峰依然能稳定跑出 800Mbps+ 且丢包率接近 0.00% 的专线，才是真正具备高 SLA 骨干品质的顶级梯子。
            </p>
          </div>
        </div>
      </section>

      <!-- 模块四：联动跳转其他核心板块 -->
      <footer class="pt-8 border-t border-slate-200/80 dark:border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-slate-500 dark:text-slate-400">
          想查看全维度表格参数比对？请前往对比矩阵板块。
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/comparison-matrix"
            class="px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-sky-400 text-slate-700 dark:text-slate-200 transition-colors inline-flex items-center gap-1.5"
          >
            <Layers class="w-3.5 h-3.5" />
            <span>查看横向对比矩阵表格</span>
          </a>
          <a
            href="/category"
            class="px-4 py-2 rounded-xl text-xs font-semibold bg-sky-500 hover:bg-sky-600 text-white transition-colors inline-flex items-center gap-1.5"
          >
            <Sparkles class="w-3.5 h-3.5" />
            <span>按场景快速选型指南</span>
          </a>
        </div>
      </footer>

    </div>
  </main>
</Layout>
