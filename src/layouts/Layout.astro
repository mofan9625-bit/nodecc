---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article' | 'review';
  rating?: {
    overall: number;
    speed: number;
    stability: number;
    streaming: number;
    support: number;
  };
  productName?: string;
  price?: {
    minMonthly: number;
    currency: string;
  };
  hasSidebar?: boolean;
}

const {
  title,
  description,
  image,
  articleDate,
  updatedDate,
  type = 'website',
  rating,
  productName,
  price,
  hasSidebar = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="节点实验室 RSS 订阅" href="/rss.xml" />
  <meta name="theme-color" content="#0ea5e9" />
  <meta http-equiv="content-language" content="zh-CN" />

  <!-- 预连接到字体等关键第三方资源（性能优化）-->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  
  <!-- SEO 组件（含 OG / Twitter / JSON-LD / Bing 验证码） -->
  <SEO
    title={title}
    description={description}
    image={image}
    articleDate={articleDate}
    updatedDate={updatedDate}
    type={type}
    rating={rating}
    productName={productName}
    price={price}
  />
</head>

<body class="font-sans antialiased bg-[--bg-page] text-[--text-primary] transition-colors duration-200 grid-pattern min-h-screen flex flex-col">
  
  <!-- 初始化主题：避免 FOUC（页面闪烁无主题） -->
  <script is:inline>
    (() => {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'light' || (!stored && !prefersDark)) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <Header />
  
  <main class="flex-1 w-full min-w-0" id="main-content">
    <slot />
  </main>

  <Footer />

</body>
</html>
