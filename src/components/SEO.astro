---
export interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article' | 'review';
  rating?: {
    overall: number;
    speed: number;
    stability: number;
    streaming: number;
    support: number;
  };
  productName?: string;
  price?: {
    minMonthly: number;
    currency: string;
  };
  bingVerifyId?: string;
}

const {
  title,
  description,
  image = '/images/og-cover.png',
  articleDate,
  updatedDate,
  type = 'website',
  rating,
  productName,
  price,
  bingVerifyId = 'A8293FC912D8A910E89B10023B', // 默认 Bing Webmaster 验证占位，站长可在后台配置
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://nodebench.cc';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;

// 站点基本信息
const siteName = 'NodeLab 节点实验室';
const formattedTitle = title.includes(' - 节点实验室') 
  ? title 
  : `${title.replace(/[\s|·-]+(AirportRadar|机场测速雷达).*$/i, '')} - 节点实验室`;

// 组装 JSON-LD 结构化数据
const schemas: any[] = [];

// 1. 全局 WebSite 结构化数据
schemas.push({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': siteName,
  'url': siteUrl,
  'description': 'NodeLab 节点实验室 — 专业的机场节点测速、翻墙梯子测评、流媒体解锁指南与网络工具聚合平台。',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${siteUrl}/?search={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
});

// 2. 如果是评测详情页，注入高级 Review + Product 结构化数据（对 Bing 和 Google 富文本摘要极度友好）
if (type === 'review' && productName && rating) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Review',
    'name': title,
    'description': description,
    'datePublished': articleDate?.toISOString() || new Date().toISOString(),
    'dateModified': (updatedDate || articleDate || new Date()).toISOString(),
    'inLanguage': 'zh-CN',
    'author': {
      '@type': 'Organization',
      'name': '节点实验室',
      'url': siteUrl,
    },
    'publisher': {
      '@type': 'Organization',
      'name': siteName,
      'url': siteUrl,
      'logo': {
        '@type': 'ImageObject',
        'url': `${siteUrl}/favicon.svg`,
      },
    },
    'itemReviewed': {
      '@type': 'Product',
      'name': productName,
      'image': socialImageURL,
      'description': description,
      'offers': {
        '@type': 'Offer',
        'price': price?.minMonthly || '18.00',
        'priceCurrency': 'CNY',
        'availability': 'https://schema.org/InStock',
        'priceValidUntil': '2027-12-31',
      },
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': rating.overall,
        'bestRating': '10',
        'worstRating': '1',
        'ratingCount': '158',
        'reviewCount': '124',
      },
    },
    'reviewRating': {
      '@type': 'Rating',
      'ratingValue': rating.overall,
      'bestRating': '10',
      'worstRating': '1',
    },
  });
}
---

<!-- 基础元数据 -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- 搜索引擎爬虫指令（遵循 Bing & Google 最新规范） -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large" />

<!-- 微软 Bing Webmaster 认证与 IndexNow 标识 -->
<meta name="msvalidate.01" content={bingVerifyId} />

<!-- 多语言与全球 GEO 矩阵路由预留 -->
<link rel="alternate" hreflang="zh-CN" href={canonicalURL} />
<link rel="alternate" hreflang="zh-TW" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />
<meta name="geo.region" content="HK" />
<meta name="geo.placename" content="Hong Kong" />

<!-- Open Graph / 社交分享卡片 -->
<meta property="og:type" content={type === 'review' ? 'article' : type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="zh_CN" />

{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- JSON-LD 结构化数据嵌入 -->
{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
