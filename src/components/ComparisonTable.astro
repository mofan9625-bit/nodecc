<script is:inline>
  // 优惠券一键复制并反馈交互
  document.querySelectorAll('.copy-coupon-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const code = btn.getAttribute('data-code');
      if (code) {
        try {
          await navigator.clipboard.writeText(code);
          const originalText = btn.innerHTML;
          btn.innerHTML = '<span>已复制!</span>';
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      }
    });
  });

  // 锚点平滑定位与高亮动效
  function highlightTargetAnchor() {
    if (window.location.hash && window.location.hash.startsWith('#matrix-')) {
      const hash = window.location.hash;
      const target = document.querySelector(hash) || document.querySelector(hash + '-mobile');
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('ring-2', 'ring-sky-500', 'bg-sky-500/15');
          setTimeout(() => target.classList.remove('ring-2', 'ring-sky-500', 'bg-sky-500/15'), 2500);
        }, 120);
      }
    }
  }
  window.addEventListener('load', highlightTargetAnchor);
  window.addEventListener('hashchange', highlightTargetAnchor);
  if (document.readyState === 'complete') {
    highlightTargetAnchor();
  }
</script>

