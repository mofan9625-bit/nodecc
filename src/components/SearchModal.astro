---
import { 
  Search, 
  X, 
  CornerDownLeft, 
  ArrowRight, 
  Sparkles, 
  Flame, 
  Layers, 
  BarChart3, 
  BookOpen, 
  Wrench, 
  Zap, 
  ShieldCheck,
  Tag,
  SlidersHorizontal
} from 'lucide-astro';
import { SEARCH_ITEMS } from '../data/searchData';

// 热门搜索推荐词
const popularKeywords = [
  '云界线',
  '¥5.60平价',
  '全 IPLC 专线',
  'Clash Verge',
  'ChatGPT防封',
  '小火箭 iOS',
  'Sing-box',
  'Netflix 解锁',
  '外服游戏加速',
  '边缘节点',
];

// 推荐快速直达
const quickNavs = [
  {
    title: '云界线 (Yunjiexian) · 2026 年度高性价比机皇',
    desc: '全 IEPL 内网专线 · 晚高峰实测 920Mbps · ¥5.60/月起',
    url: '/reviews/yunjiexian-review',
    badge: '👑 性价比机皇',
    category: '机场评测',
  },
  {
    title: '优质机场梯子全维度对比表格 (横评对比矩阵)',
    desc: '综合对比 9 大品牌的线路架构、实测带宽、解锁与真实月付价格',
    url: '/comparison-matrix',
    badge: '📊 横评矩阵',
    category: '对比矩阵',
  },
  {
    title: '晚高峰 1000Mbps 4K/8K 节点自动化实测监控报告',
    desc: '晚高峰 20:30-22:30 实机跑分、丢包率与网络抖动评级',
    url: '/speedtest-reports',
    badge: '⚡ 真实测速',
    category: '节点测速',
  },
  {
    title: 'Clash Verge Rev 新手小白保姆级配置教程',
    desc: '新一代跨平台代理客户端 · 订阅一键导入 · TUN 模式分流',
    url: '/tutorials/clash-verge-rev-tutorial',
    badge: '📖 客户端教程',
    category: '新手教程',
  },
  {
    title: '常用科学上网工具与 IP / DNS 泄漏检测工具集',
    desc: 'IP 属地检测、WebRTC 泄漏、Speedtest 与主流客户端官方下载通道',
    url: '/tools',
    badge: '🛠️ 网络工具',
    category: '科学工具',
  },
];
---

<!-- 嵌入静态搜索索引 JSON 数据 -->
<script is:inline type="application/json" id="search-modal-data" set:html={JSON.stringify(SEARCH_ITEMS)} />

<!-- 搜索模态框全屏遮罩容器（默认隐藏） -->
<div
  id="search-modal-overlay"
  class="fixed inset-0 z-[100] hidden bg-slate-950/70 dark:bg-black/80 backdrop-blur-sm p-4 sm:p-6 md:p-8 overflow-y-auto transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="全局全景搜索"
>
  <div class="min-h-full flex items-start justify-center pt-8 sm:pt-14 pb-12">
    
    <!-- 模态框主体卡片 (Command Palette 风格) -->
    <div
      id="search-modal-container"
      class="w-full max-w-2xl bg-white dark:bg-[#0c121e] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col transition-all duration-200 transform scale-95 opacity-0 ring-1 ring-slate-900/5 dark:ring-white/10"
    >
      
      <!-- 搜索顶部输入区域 -->
      <div class="relative flex items-center px-4 sm:px-5 py-3.5 border-b border-slate-200/90 dark:border-slate-800">
        <div class="p-1.5 rounded-lg bg-sky-500/10 text-sky-500 mr-3 flex-shrink-0">
          <Search class="w-5 h-5 text-sky-500 animate-pulse" />
        </div>
        
        <input
          id="search-modal-input"
          type="search"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="搜索机场、线路、套餐价格、新手教程、工具..."
          class="w-full bg-transparent text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 text-base sm:text-lg focus:outline-none focus:ring-0 border-0 p-0"
        />

        <div class="flex items-center gap-2 ml-2 flex-shrink-0">
          <!-- 清空输入按钮 -->
          <button
            id="search-modal-clear"
            type="button"
            class="hidden p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            title="清空搜索内容"
            aria-label="清空输入"
          >
            <X class="w-4 h-4" />
          </button>

          <!-- ESC 关闭快捷提示 -->
          <button
            id="search-modal-close"
            type="button"
            class="px-2 py-1 rounded-md text-[11px] font-mono font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition-colors"
            title="关闭搜索弹窗 (ESC)"
            aria-label="关闭"
          >
            ESC
          </button>
        </div>
      </div>

      <!-- 分类快速筛选胶囊标签 (Pills) -->
      <div class="px-4 sm:px-5 py-2.5 bg-slate-50/70 dark:bg-[#090d16]/70 border-b border-slate-100 dark:border-slate-800/80 flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar">
        <span class="text-slate-400 dark:text-slate-500 font-medium mr-1 flex items-center gap-1 flex-shrink-0">
          <SlidersHorizontal class="w-3 h-3" />
          <span>分类:</span>
        </span>
        <button
          type="button"
          data-category="全部"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap bg-sky-500 text-white shadow-sm shadow-sky-500/20"
        >
          全部
        </button>
        <button
          type="button"
          data-category="机场评测"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800"
        >
          🚀 机场评测
        </button>
        <button
          type="button"
          data-category="对比矩阵"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800"
        >
          📊 对比矩阵
        </button>
        <button
          type="button"
          data-category="新手教程"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800"
        >
          📖 新手教程
        </button>
        <button
          type="button"
          data-category="科学工具"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800"
        >
          🛠️ 科学工具
        </button>
        <button
          type="button"
          data-category="专题分类"
          class="search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800"
        >
          🏷️ 专题分类
        </button>
      </div>

      <!-- 搜索结果 / 默认推荐滚动区域 -->
      <div
        id="search-modal-scroll"
        class="max-h-[58vh] sm:max-h-[62vh] overflow-y-auto p-3 sm:p-4 divide-y divide-slate-100 dark:divide-slate-800/60 focus:outline-none"
        tabindex="-1"
      >
        <!-- 动态结果挂载容器 -->
        <div id="search-modal-results" class="space-y-1.5">
          <!-- JS 动态注入匹配结果 -->
        </div>

        <!-- 初始默认空输入状态：展示热门搜索与推荐直达 -->
        <div id="search-modal-default-state" class="py-2 space-y-6">
          <!-- 热门搜索推荐 -->
          <div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-2.5 px-1">
              <Flame class="w-3.5 h-3.5 text-amber-500" />
              <span>热门搜索推荐</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {popularKeywords.map((kw) => (
                <button
                  type="button"
                  class="popular-keyword-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:bg-sky-50 dark:hover:bg-sky-950/50 hover:text-sky-600 dark:hover:text-sky-400 border border-slate-200/70 dark:border-slate-700/60 transition-colors"
                  data-keyword={kw}
                >
                  {kw}
                </button>
              ))}
            </div>
          </div>

          <!-- 推荐快速直达 -->
          <div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-2 px-1">
              <Sparkles class="w-3.5 h-3.5 text-sky-500" />
              <span>推荐直达导航</span>
            </div>
            <div class="space-y-1.5">
              {quickNavs.map((nav) => (
                <a
                  href={nav.url}
                  class="search-nav-item flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100/80 dark:hover:bg-slate-800/60 border border-transparent hover:border-slate-200 dark:hover:border-slate-700/80 transition-all group"
                >
                  <div class="flex items-start gap-2.5 min-w-0 pr-2">
                    <div class="mt-0.5 p-1.5 rounded-lg bg-sky-500/10 text-sky-500 flex-shrink-0 group-hover:scale-105 transition-transform">
                      <Zap class="w-4 h-4" />
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors truncate">
                          {nav.title}
                        </span>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-600 dark:text-sky-400 font-medium">
                          {nav.badge}
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5 truncate">
                        {nav.desc}
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center text-slate-400 group-hover:text-sky-500 transition-colors flex-shrink-0">
                    <ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 无搜索结果提示状态（默认隐藏） -->
        <div id="search-modal-empty" class="hidden py-12 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 mb-3">
            <Search class="w-6 h-6" />
          </div>
          <h4 class="text-base font-bold text-slate-800 dark:text-slate-200 mb-1">
            未找到与「<span id="search-modal-empty-query" class="text-sky-500 font-mono"></span>」匹配的内容
          </h4>
          <p class="text-xs text-slate-400 dark:text-slate-500 max-w-sm mx-auto mb-4 leading-relaxed">
            支持输入中文、拼音全拼或简拼（如 <code class="font-mono text-sky-500 bg-sky-50 dark:bg-sky-950/50 px-1 py-0.5 rounded">yjx</code>、<code class="font-mono text-sky-500 bg-sky-50 dark:bg-sky-950/50 px-1 py-0.5 rounded">dly</code>）、价格（如 <code class="font-mono text-sky-500 bg-sky-50 dark:bg-sky-950/50 px-1 py-0.5 rounded">5.6</code>）或工具协议（如 <code class="font-mono text-sky-500 bg-sky-50 dark:bg-sky-950/50 px-1 py-0.5 rounded">clash</code>、<code class="font-mono text-sky-500 bg-sky-50 dark:bg-sky-950/50 px-1 py-0.5 rounded">iplc</code>）。
          </p>
          <div class="flex justify-center gap-2">
            <button
              type="button"
              id="search-reset-all-btn"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-sky-500 text-white hover:bg-sky-600 transition-colors shadow-sm shadow-sky-500/20"
            >
              清空并查看全部机场
            </button>
          </div>
        </div>

      </div>

      <!-- 搜索模态框底部操作引导栏 -->
      <div class="px-4 sm:px-5 py-2.5 bg-slate-50 dark:bg-[#080c14] border-t border-slate-200/90 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 flex-wrap gap-2">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1 font-mono">
            <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs text-[10px]">↑</kbd>
            <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs text-[10px]">↓</kbd>
            <span class="text-slate-400">选择</span>
          </span>
          <span class="inline-flex items-center gap-1 font-mono">
            <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs text-[10px]">↵</kbd>
            <span class="text-slate-400">打开</span>
          </span>
          <span class="inline-flex items-center gap-1 font-mono">
            <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs text-[10px]">ESC</kbd>
            <span class="text-slate-400">关闭</span>
          </span>
        </div>

        <div id="search-modal-stat" class="text-[11px] text-slate-400 dark:text-slate-500 hidden sm:block">
          收录 9 大专线机场 · 9 篇深度教程 · 全套网络工具
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // 1. 获取 DOM 元素
    const overlay = document.getElementById('search-modal-overlay');
    const container = document.getElementById('search-modal-container');
    const input = document.getElementById('search-modal-input');
    const clearBtn = document.getElementById('search-modal-clear');
    const closeBtn = document.getElementById('search-modal-close');
    const resultsContainer = document.getElementById('search-modal-results');
    const defaultState = document.getElementById('search-modal-default-state');
    const emptyState = document.getElementById('search-modal-empty');
    const emptyQuerySpan = document.getElementById('search-modal-empty-query');
    const resetAllBtn = document.getElementById('search-reset-all-btn');
    const statEl = document.getElementById('search-modal-stat');
    const categoryBtns = document.querySelectorAll('.search-category-btn');

    // 2. 加载静态索引数据
    let searchData = [];
    try {
      const dataScript = document.getElementById('search-modal-data');
      if (dataScript && dataScript.textContent) {
        searchData = JSON.parse(dataScript.textContent);
      }
    } catch (err) {
      console.error('[SearchModal] Failed to parse search data', err);
    }

    let activeIndex = 0;
    let currentResults = [];
    let currentCategory = '全部';

    // 3. 操作系统按键提示自适应 (Mac: ⌘K, Win/Linux: Ctrl K)
    const isMac = typeof navigator !== 'undefined' && /Mac|iPod|iPhone|iPad/.test(navigator.userAgent);
    const kbdShortcutBadges = document.querySelectorAll('#search-kbd-shortcut, .search-kbd-hint');
    kbdShortcutBadges.forEach((el) => {
      el.textContent = isMac ? '⌘K' : 'Ctrl K';
    });

    // 4. 打开与关闭模态框
    function openModal() {
      if (!overlay) return;
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // 动效触发
      requestAnimationFrame(() => {
        container?.classList.remove('scale-95', 'opacity-0');
        container?.classList.add('scale-100', 'opacity-100');
        input?.focus();
        if (input && input.value) {
          input.select();
        }
      });

      render();
    }

    function closeModal() {
      if (!overlay) return;
      container?.classList.add('scale-95', 'opacity-0');
      container?.classList.remove('scale-100', 'opacity-100');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 150);
    }

    // 5. 绑定全局呼出事件：点击按钮 + Cmd/Ctrl + K + / 快捷键
    const globalSearchBtn = document.getElementById('global-search-btn');
    globalSearchBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });

    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    mobileSearchBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });

    window.addEventListener('keydown', (e) => {
      // Cmd + K (Mac) 或 Ctrl + K (Windows/Linux)
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (overlay && overlay.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
        return;
      }

      // 按 / 键快捷唤起（避免在其他输入框聚焦时触发）
      if (e.key === '/' && overlay && overlay.classList.contains('hidden')) {
        const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
        if (activeTag !== 'input' && activeTag !== 'textarea' && !document.activeElement?.isContentEditable) {
          e.preventDefault();
          openModal();
          return;
        }
      }

      // 模态框打开时的按键导航
      if (overlay && !overlay.classList.contains('hidden')) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentResults.length > 0) {
            activeIndex = (activeIndex + 1) % currentResults.length;
            updateActiveHighlight();
          }
          return;
        }

        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentResults.length > 0) {
            activeIndex = (activeIndex - 1 + currentResults.length) % currentResults.length;
            updateActiveHighlight();
          }
          return;
        }

        if (e.key === 'Enter') {
          e.preventDefault();
          if (currentResults.length > 0 && currentResults[activeIndex]) {
            navigateTo(currentResults[activeIndex].url);
          }
          return;
        }
      }
    });

    // 点击遮罩层外侧关闭
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
        render();
      }
    });

    resetAllBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      currentCategory = '全部';
      updateCategoryButtons();
      render();
      input?.focus();
    });

    // 热门关键词点击一键搜索
    document.querySelectorAll('.popular-keyword-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kw = btn.getAttribute('data-keyword') || '';
        if (input) {
          input.value = kw;
          render();
          input.focus();
        }
      });
    });

    // 分类筛选切换
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || '全部';
        updateCategoryButtons();
        render();
      });
    });

    function updateCategoryButtons() {
      categoryBtns.forEach((btn) => {
        const cat = btn.getAttribute('data-category');
        if (cat === currentCategory) {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap bg-sky-500 text-white shadow-sm shadow-sky-500/20';
        } else {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-lg font-medium transition-all whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800';
        }
      });
    }

    // 6. 前端静态模糊搜索算法（支持拼音、简拼、中文汉字、价格数字与标签）
    function searchItems(query, category) {
      const q = query.trim().toLowerCase();
      
      let dataset = searchData;
      if (category && category !== '全部') {
        dataset = dataset.filter((item) => item.category === category);
      }

      if (!q) {
        return [];
      }

      // 计算每个项目的匹配得分
      const scoredItems = [];

      for (const item of dataset) {
        let score = 0;
        const titleLower = item.title.toLowerCase();
        const subLower = (item.subtitle || '').toLowerCase();
        const pinyinLower = (item.pinyin || '').toLowerCase();
        const initialsLower = (item.initials || '').toLowerCase();
        const priceLower = (item.price || '').toLowerCase();
        const tagsLower = (item.tags || []).map((t) => t.toLowerCase());
        const aliasesLower = (item.aliases || []).map((a) => a.toLowerCase());

        // 1. 标题完全匹配或前缀匹配
        if (titleLower === q) {
          score += 150;
        } else if (titleLower.startsWith(q)) {
          score += 100;
        } else if (titleLower.includes(q)) {
          score += 75;
        }

        // 2. 拼音首字母简拼 (例如: yjx, dly, hqt, kl, cvr, xhj)
        if (initialsLower === q) {
          score += 110;
        } else if (initialsLower.startsWith(q)) {
          score += 90;
        } else if (initialsLower.includes(q)) {
          score += 65;
        }

        // 3. 拼音全拼匹配 (例如: yunjiexian, dalao, jiaocheng)
        if (pinyinLower === q) {
          score += 105;
        } else if (pinyinLower.startsWith(q) || pinyinLower.includes(' ' + q)) {
          score += 85;
        } else if (pinyinLower.includes(q)) {
          score += 55;
        }

        // 4. 价格与数字匹配 (例如: 5.6, 15, 8, 10, 14, 920, 2.5)
        if (priceLower.includes(q)) {
          score += 80;
        }

        // 5. 标签与协议匹配 (例如: iplc, iepl, vless, netflix, chatgpt)
        for (const tag of tagsLower) {
          if (tag === q) {
            score += 85;
            break;
          } else if (tag.includes(q)) {
            score += 50;
            break;
          }
        }

        // 6. 别名与英文名匹配 (例如: EdgeNova, CVR, CFW, Shadowrocket)
        for (const alias of aliasesLower) {
          if (alias === q) {
            score += 95;
            break;
          } else if (alias.includes(q)) {
            score += 60;
            break;
          }
        }

        // 7. 副标题/摘要描述匹配
        if (subLower.includes(q)) {
          score += 35;
        }

        if (score > 0) {
          scoredItems.push({ item, score });
        }
      }

      // 按得分从高到低排序，同分按评分或原始顺序排序
      scoredItems.sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }
        return (b.item.rating || 0) - (a.item.rating || 0);
      });

      return scoredItems.map((s) => s.item);
    }

    // 7. 关键词高亮渲染辅助函数
    function highlightText(text, query) {
      if (!query || !text) return text;
      const q = query.trim();
      if (!q) return text;
      
      try {
        const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        return text.replace(regex, '<mark class="bg-sky-500/20 text-sky-600 dark:text-sky-400 font-bold px-0.5 rounded">$1</mark>');
      } catch {
        return text;
      }
    }

    // 分类图标与徽章颜色映射
    function getCategoryMeta(cat) {
      switch (cat) {
        case '机场评测':
          return {
            icon: '🚀',
            badgeClass: 'bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20',
          };
        case '对比矩阵':
          return {
            icon: '📊',
            badgeClass: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20',
          };
        case '新手教程':
          return {
            icon: '📖',
            badgeClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20',
          };
        case '科学工具':
          return {
            icon: '🛠️',
            badgeClass: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20',
          };
        case '专题分类':
          return {
            icon: '🏷️',
            badgeClass: 'bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20',
          };
        default:
          return {
            icon: '🔍',
            badgeClass: 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border border-slate-500/20',
          };
      }
    }

    // 8. 实时渲染搜索结果
    function render() {
      const query = input?.value || '';
      
      // 控制清空按钮显隐
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', query.length === 0);
      }

      if (!query.trim()) {
        currentResults = [];
        if (resultsContainer) resultsContainer.innerHTML = '';
        defaultState?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
        if (statEl) {
          statEl.textContent = '收录 9 大专线机场 · 9 篇深度教程 · 全套网络工具';
        }
        return;
      }

      defaultState?.classList.add('hidden');

      currentResults = searchItems(query, currentCategory);
      activeIndex = 0;

      if (statEl) {
        statEl.textContent = `找到 ${currentResults.length} 条匹配结果`;
      }

      if (currentResults.length === 0) {
        if (resultsContainer) resultsContainer.innerHTML = '';
        if (emptyQuerySpan) emptyQuerySpan.textContent = query;
        emptyState?.classList.remove('hidden');
        return;
      }

      emptyState?.classList.add('hidden');

      // 渲染匹配列表
      if (resultsContainer) {
        resultsContainer.innerHTML = currentResults
          .map((item, idx) => {
            const meta = getCategoryMeta(item.category);
            const titleHtml = highlightText(item.title, query);
            const subHtml = highlightText(item.subtitle, query);
            const isSelected = idx === activeIndex;

            return `
              <div
                class="search-result-row group flex items-start justify-between p-3 rounded-xl cursor-pointer transition-all duration-150 ${
                  isSelected
                    ? 'bg-sky-50/90 dark:bg-sky-950/60 ring-1 ring-sky-500/40 border-l-4 border-l-sky-500 shadow-sm'
                    : 'hover:bg-slate-100/70 dark:hover:bg-slate-800/50 border-l-4 border-l-transparent'
                }"
                data-index="${idx}"
                data-url="${item.url}"
              >
                <div class="flex items-start gap-3 min-w-0 flex-1 pr-3">
                  <div class="mt-0.5 text-base flex-shrink-0">
                    ${meta.icon}
                  </div>
                  <div class="min-w-0 flex-1">
                    <!-- 类别与徽章行 -->
                    <div class="flex items-center gap-1.5 flex-wrap mb-1">
                      <span class="text-[10px] px-1.5 py-0.5 rounded-md font-semibold ${meta.badgeClass}">
                        ${item.category}
                      </span>
                      ${
                        item.badge
                          ? `<span class="text-[10px] px-1.5 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-medium">${item.badge}</span>`
                          : ''
                      }
                      ${
                        item.price
                          ? `<span class="text-[10px] px-1.5 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono font-bold">${item.price}</span>`
                          : ''
                      }
                      ${
                        item.rating
                          ? `<span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium">评分: <strong class="text-emerald-500">${item.rating}</strong></span>`
                          : ''
                      }
                    </div>

                    <!-- 标题行 -->
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors leading-snug">
                      ${titleHtml}
                    </h3>

                    <!-- 副标题描述行 -->
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-1 leading-relaxed">
                      ${subHtml}
                    </p>
                  </div>
                </div>

                <!-- 右侧回车直达提示 -->
                <div class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500 group-hover:text-sky-500 transition-colors flex-shrink-0 pt-1">
                  <span class="hidden sm:inline text-[10px] font-mono opacity-0 group-hover:opacity-100 transition-opacity">跳转</span>
                  <kbd class="hidden sm:inline-block px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-[9px] font-mono shadow-xs">↵</kbd>
                </div>
              </div>
            `;
          })
          .join('');

        // 绑定结果项点击事件与悬浮同步
        resultsContainer.querySelectorAll('.search-result-row').forEach((row) => {
          row.addEventListener('click', () => {
            const url = row.getAttribute('data-url');
            if (url) navigateTo(url);
          });

          row.addEventListener('mouseenter', () => {
            const idx = parseInt(row.getAttribute('data-index') || '0', 10);
            if (!isNaN(idx)) {
              activeIndex = idx;
              updateActiveHighlight();
            }
          });
        });
      }
    }

    // 9. 更新高亮聚焦状态
    function updateActiveHighlight() {
      const rows = resultsContainer?.querySelectorAll('.search-result-row');
      if (!rows) return;
      rows.forEach((row, idx) => {
        if (idx === activeIndex) {
          row.className =
            'search-result-row group flex items-start justify-between p-3 rounded-xl cursor-pointer transition-all duration-150 bg-sky-50/90 dark:bg-sky-950/60 ring-1 ring-sky-500/40 border-l-4 border-l-sky-500 shadow-sm';
          row.scrollIntoView({ block: 'nearest' });
        } else {
          row.className =
            'search-result-row group flex items-start justify-between p-3 rounded-xl cursor-pointer transition-all duration-150 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 border-l-4 border-l-transparent';
        }
      });
    }

    // 10. 跳转处理
    function navigateTo(url) {
      if (!url) return;
      closeModal();
      window.location.href = url;
    }

    // 监听输入事件
    input?.addEventListener('input', render);
  })();
</script>
