---
import { 
  FlaskConical, 
  Search, 
  Sun, 
  Moon, 
  Menu, 
  X, 
  Zap, 
  ShieldCheck, 
  BarChart3, 
  Wrench, 
  Layers,
  Activity,
  BookOpen
} from 'lucide-astro';
import SearchModal from './SearchModal.astro';

const navItems = [
  { name: '首页', href: '/', icon: Zap },
  { name: '机场评测', href: '/reviews', icon: Layers },
  { name: '对比矩阵', href: '/comparison-matrix', icon: BarChart3 },
  { name: '节点测速', href: '/speedtest-reports', icon: Activity },
  { name: '科学上网工具', href: '/tools', icon: Wrench },
  { name: '新手教程', href: '/tutorials', icon: BookOpen },
  { name: '免责声明', href: '/disclaimer', icon: ShieldCheck },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-[#080c14]/85 backdrop-blur-md transition-colors duration-200">
  <!-- 顶部微公告广播条 -->
  <div class="bg-gradient-to-r from-sky-500/10 via-indigo-500/10 to-emerald-500/10 border-b border-sky-500/20 text-xs py-1.5 px-4 text-center text-slate-600 dark:text-slate-300 font-medium">
    <span class="inline-flex items-center gap-1.5">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>【2026 最新实测】晚高峰 1000Mbps 4K/8K 专线节点抗封锁监控中，首选专线无视高峰拥堵</span>
    </span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- LOGO -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform duration-200">
          <FlaskConical class="w-5 h-5 animate-pulse" />
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-bold tracking-tight bg-gradient-to-r from-slate-900 via-sky-600 to-indigo-600 dark:from-white dark:via-sky-300 dark:to-indigo-400 bg-clip-text text-transparent">
            NodeLab
          </span>
          <span class="text-[10px] font-semibold tracking-wider text-slate-500 dark:text-slate-400 uppercase -mt-1">
            节点实验室
          </span>
        </div>
      </a>

      <!-- 桌面端主导航 -->
      <nav class="hidden md:flex items-center gap-1" aria-label="主要导航">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 flex items-center gap-1.5 ${
                isActive
                  ? 'text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/50'
                  : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
              }`}
            >
              <item.icon class="w-4 h-4 opacity-75" />
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- 右侧操作区：全局搜索 + 主题切换 + 移动端菜单按钮 -->
      <div class="flex items-center gap-2.5">
        <!-- 全局快捷搜索触发器 -->
        <button
          type="button"
          id="global-search-btn"
          class="flex items-center gap-2 px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 rounded-lg border border-slate-200 dark:border-slate-700/70 transition-colors cursor-pointer"
          title="搜索机场评测、工具与教程"
          aria-label="全局搜索"
        >
          <Search class="w-3.5 h-3.5 text-slate-400" />
          <span class="hidden sm:inline">搜索评测/工具...</span>
          <kbd id="search-kbd-shortcut" class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-400 font-mono">⌘K</kbd>
        </button>

        <!-- 暗黑/明亮主题切换 -->
        <button
          id="theme-toggle"
          type="button"
          class="p-2 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors"
          aria-label="切换暗黑/明亮主题"
        >
          <Sun class="w-5 h-5 hidden dark:block text-amber-400" />
          <Moon class="w-5 h-5 block dark:hidden text-slate-600" />
        </button>

        <!-- 移动端汉堡菜单触发按钮 -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg"
          aria-label="展开菜单"
        >
          <Menu class="w-6 h-6 block menu-open-icon" />
          <X class="w-6 h-6 hidden menu-close-icon" />
        </button>
      </div>

    </div>
  </div>

  <!-- 移动端下拉菜单 -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#080c14]/95 px-4 pt-3 pb-4 space-y-1 backdrop-blur-lg">
    <!-- 移动端快速搜索呼出按钮 -->
    <button
      type="button"
      id="mobile-search-btn"
      class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-sky-50/80 dark:bg-sky-950/40 border border-sky-200/80 dark:border-sky-800/60 mb-2 hover:bg-sky-100 dark:hover:bg-sky-900/50 transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2.5 text-sky-600 dark:text-sky-400">
        <Search class="w-4 h-4" />
        <span>搜索机场、评测与教程...</span>
      </div>
      <kbd class="search-kbd-hint px-1.5 py-0.5 text-[10px] bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-slate-500 font-mono">⌘K</kbd>
    </button>

    {navItems.map((item) => (
      <a
        href={item.href}
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/70"
      >
        <item.icon class="w-5 h-5 text-sky-500" />
        <span>{item.name}</span>
      </a>
    ))}
  </div>
</header>

<!-- 全局 Command Palette 搜索模态框 -->
<SearchModal />

<script is:inline>
  // 零运行时依赖的主题切换脚本
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // 移动端菜单展开逻辑
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = mobileMenuBtn?.querySelector('.menu-open-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.menu-close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden', !isExpanded);
    closeIcon?.classList.toggle('hidden', isExpanded);
  });

  const mobileSearchBtnInHeader = document.getElementById('mobile-search-btn');
  mobileSearchBtnInHeader?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  });
</script>
