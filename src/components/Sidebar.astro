    discount: '专属优惠码',
    url: '/reviews/liulianyun-review',
    directUrl: 'https://mofan88.liulianyunaff.com/#/?code=ETsQBSuR',
    highlight: 'border-slate-500/20',
  },
  {
    rank: 5,
    name: '闪电鼠',
    badge: '闪电极速首选',
    lineType: '全 IEPL 内网专线',
    speed: '820 Mbps',
    rating: 9.3,
    price: '¥5.6/月起',
    coupon: 'sds888',
    discount: '专属优惠码',
    url: '/reviews/shandianshu-review',
    directUrl: 'https://mofanvip01.shandianshuaff.com/#/?code=a3GAQAXg',
    highlight: 'border-slate-500/20',
  },
];

const categoryTags = [
  { name: 'IPLC 纯专线', count: 18, color: 'text-sky-500 bg-sky-500/10 border-sky-500/20', href: '/category/iplc/' },
  { name: 'IEPL 内网专线', count: 12, color: 'text-indigo-500 bg-indigo-500/10 border-indigo-500/20', href: '/category/iplc/' },
  { name: '4K/8K 流媒体解锁', count: 24, color: 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20', href: '/category/streaming/' },
  { name: 'ChatGPT / Claude 专线', count: 21, color: 'text-amber-500 bg-amber-500/10 border-amber-500/20', href: '/category/ai/' },
  { name: '低延迟电竞节点', count: 9, color: 'text-purple-500 bg-purple-500/10 border-purple-500/20', href: '/category/gaming/' },
  { name: '按量付费不限时', count: 14, color: 'text-rose-500 bg-rose-500/10 border-rose-500/20', href: '/category/budget/' },
  { name: 'BGP 多线高防', count: 16, color: 'text-teal-500 bg-teal-500/10 border-teal-500/20', href: '/category/iplc/' },
  { name: '跨境电商 / 原生住宅 IP', count: 7, color: 'text-cyan-500 bg-cyan-500/10 border-cyan-500/20', href: '/category/enterprise/' },
