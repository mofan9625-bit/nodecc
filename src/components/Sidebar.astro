---
import { 
  Trophy, 
  Tag, 
  Bell, 
  ExternalLink, 
  Zap, 
  CheckCircle2, 
  Percent, 
  Flame, 
  Sparkles, 
  ArrowRight 
} from 'lucide-astro';

// 热门榜单数据（可由父组件传入或在此维护默认顶级榜单）
export interface Props {
  activeTag?: string;
}

const { activeTag } = Astro.props;

const topAirports = [
  {
    rank: 1,
    name: '云界线',
    badge: '综合评测机皇',
    lineType: '全 IEPL 内网专线',
    speed: '920 Mbps',
    rating: 9.8,
    price: '¥5.6/月起',
    coupon: 'yjx888',
    discount: '专属优惠码',
    url: '/reviews/yunjiexian-review',
    directUrl: 'https://9625mofan01.yunjiexianaff.com/#/?code=OOYhSj0L',
    highlight: 'border-amber-500/50 dark:border-amber-500/40 bg-amber-500/5',
  },
  {
    rank: 2,
    name: '大佬云',
    badge: '平价专线黑马',
    lineType: '全 IEPL 内网专线',
    speed: '880 Mbps',
    rating: 9.6,
    price: '¥5.6/月起',
    coupon: 'dly888',
    discount: '专属优惠码',
    url: '/reviews/dalaoyun-review',
    directUrl: 'https://mofanvip01.dalaoyunaff.com/#/?code=QT2rqp5V',
    highlight: 'border-slate-400/40 dark:border-slate-400/30 bg-slate-400/5',
  },
  {
    rank: 3,
    name: '环球梯',
    badge: '超低延迟畅联',
    lineType: '全 IEPL 内网专线',
    speed: '850 Mbps',
    rating: 9.5,
    price: '¥5.6/月起',
    coupon: 'HQ66',
    discount: '专属优惠码',
    url: '/reviews/huanqiuti-review',
    directUrl: 'https://mofanvip01.huanqiutiaff.com/#/?code=l7oLmjVU',
    highlight: 'border-amber-700/30',
  },
  {
    rank: 4,
    name: '榴莲云',
    badge: '高性价比爆款',
    lineType: '全 IEPL 内网专线',
    speed: '780 Mbps',
    rating: 9.4,
    price: '¥5.6/月起',
