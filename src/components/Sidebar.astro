const announcements = [
  {
    date: '10-20',
    tag: '测速',
    title: '晚高峰 20:30~22:30 广港/沪日 IPLC 专线平均延迟 28ms，无丢包。',
  },
  {
    date: '10-19',
    tag: '活动',
    title: '部分顶级机场开启万圣节早鸟特惠，季付及以上最高 75 折。',
  },
  {
    date: '10-18',
    tag: '协议',
    title: '推荐升级至 Clash Verge Rev 1.7+ 或 Sing-box 1.10+ 以启用 Hysteria 2 混淆。',
  },
